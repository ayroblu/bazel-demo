load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library")
load("//swift-shared:concurrency.bzl", "SWIFT6_MAINACTOR_COPTS")

package(default_visibility = ["//sherlock-app:__subpackages__"])

swift_library(
    name = "settings",
    srcs = glob(["*.swift"]),
    copts = SWIFT6_MAINACTOR_COPTS,
    module_name = "settings",
    deps = [
        "//sherlock-app/bindings",
        "//sherlock-app/clipboard",
        "//sherlock-app/extensions",
        "//sherlock-app/hotkey",
        "//sherlock-app/preferences",
        "//sherlock-app/search",
        "//sherlock-app/snippets",
    ],
)
