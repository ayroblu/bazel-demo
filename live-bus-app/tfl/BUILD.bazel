load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library")
load("//swift-shared:concurrency.bzl", "SWIFT6_NONISOLATED_COPTS")

package(default_visibility = ["//live-bus-app:__subpackages__"])

swift_library(
    name = "tfl",
    srcs = glob(["*.swift"]),
    copts = SWIFT6_NONISOLATED_COPTS,
    module_name = "tfl",
    deps = [
        "//swift-shared/FileUtils",
        "//swift-shared/http",
    ],
)
