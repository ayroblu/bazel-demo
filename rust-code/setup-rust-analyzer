#!/bin/zsh
# Updates the Cargo.lock file
# cargo generate-lockfile
# Updates the definitions for rust analyzer
TARGET="${1:-//rust-code/...}"
RUST_TARGETS=(${(f)"$(bazel query "kind('rust_.*', $TARGET)" 2>/dev/null)"})
bazel run @rules_rust//tools/rust_analyzer:gen_rust_project -- "${RUST_TARGETS[@]}"
