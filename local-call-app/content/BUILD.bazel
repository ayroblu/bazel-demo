load("@build_bazel_rules_swift//swift:swift.bzl", "swift_library")
load("//swift-shared:concurrency.bzl", "STRICT_MAINACTOR_COPTS")

package(default_visibility = ["//local-call-app:__subpackages__"])

swift_library(
    name = "content",
    srcs = glob(["*.swift"]),
    copts = STRICT_MAINACTOR_COPTS,
    module_name = "content",
    deps = [
        "//local-call-app/audio",
        "//local-call-app/bluetooth",
        "//local-call-app/call",
        "//local-call-app/transport",
        "//local-call-app/transport-protocol",
        "//swift-shared/Log",
        "//swift-shared/LogDb",
        "//swift-shared/LogUi",
    ],
)
